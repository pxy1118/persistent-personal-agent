{
  "name": "ppa",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.11.1"
  },
  "scripts": {
    "start": "tsx src/cli.ts",
    "doctor": "tsx src/cli.ts doctor",
    "build": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "smoke:live": "tsx scripts/live-smoke.ts",
    "smoke:rhythm": "tsx scripts/live-rhythm.ts",
    "smoke:conversation": "tsx scripts/live-conversation.ts",
    "backup": "tsx src/cli.ts backup",
    "restore": "tsx src/cli.ts restore",
    "setup:tools": "tsx src/cli.ts setup-tools",
    "identity:apply": "tsx src/cli.ts identity-apply"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.85.0",
    "@earendil-works/pi-coding-agent": "0.85.0",
    "@earendil-works/pi-server": "0.85.0",
    "@earendil-works/pi-tui": "0.85.0",
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
