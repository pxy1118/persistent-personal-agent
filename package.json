{
  "name": "ppa",
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24.11.1"
  },
  "scripts": {
    "migrate:ppa": "tsx src/ppa-cli.ts migrate",
    "runtime": "tsx src/ppa-cli.ts",
    "doctor:runtime": "tsx src/ppa-cli.ts doctor",
    "backup:runtime": "tsx src/ppa-cli.ts backup",
    "restore:runtime": "tsx src/ppa-cli.ts restore",
    "runtime:build": "bun run --cwd packages/ppa-runtime build",
    "runtime:test": "bun test packages/ppa-runtime/src/backend/dev/pi-llama-cpp-provider.test.ts packages/ppa-runtime/src/websocket/listener/turn-terminal-protocol.test.ts packages/ppa-runtime/src/websocket/listener/commands/app-server-info.test.ts",
    "runtime:pack": "npm pack --workspace @ppa/runtime",
    "postinstall": "npm run runtime:build",
    "migrate:letta": "npm run migrate:ppa",
    "start:letta": "npm run runtime",
    "doctor:letta": "npm run doctor:runtime",
    "backup:letta": "npm run backup:runtime",
    "restore:letta": "npm run restore:runtime --",
    "test:letta": "tsx --test tests/ppa-runtime.test.ts",
    "smoke:letta:integration": "tsx scripts/ppa-runtime-integration.ts",
    "smoke:letta": "tsx scripts/ppa-runtime-smoke.ts",
    "start": "tsx src/ppa-terminal.ts",
    "smoke:interface": "tsx scripts/ppa-integration.ts",
    "smoke:terminal": "tsx scripts/ppa-tui-smoke.ts",
    "smoke:image": "tsx scripts/ppa-image-smoke.ts",
    "smoke:screen": "tsx scripts/ppa-screen-smoke.ts",
    "model": "tsx src/ppa-cli.ts model",
    "doctor": "tsx src/ppa-cli.ts doctor",
    "build": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "smoke:live": "tsx scripts/ppa-runtime-smoke.ts",
    "backup": "tsx src/ppa-cli.ts backup",
    "restore": "tsx src/ppa-cli.ts restore",
    "pet": "node desktop-pet/launch.mjs",
    "test:pet": "desktop-pet\\.venv\\Scripts\\python.exe -m pytest desktop-pet/tests -q",
    "smoke:pet": "tsx scripts/pet-smoke.ts",
    "smoke:pet:live": "tsx scripts/pet-smoke.ts --live",
    "smoke:pet:gui": "desktop-pet\\.venv\\Scripts\\python.exe desktop-pet/qa_live.py"
  },
  "dependencies": {
    "@ppa/runtime": "file:packages/ppa-runtime",
    "ppa-ink": "npm:ink@^7.1.1",
    "react": "^19.2.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/ws": "^8.18.1",
    "bun": "1.3.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
