{
  "name": "ppa",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.11.1"
  },
  "scripts": {
    "migrate:letta": "tsx src/letta-cli.ts migrate",
    "start:letta": "tsx src/letta-cli.ts",
    "doctor:letta": "tsx src/letta-cli.ts doctor",
    "backup:letta": "tsx src/letta-cli.ts backup",
    "restore:letta": "tsx src/letta-cli.ts restore",
    "test:letta": "tsx --test tests/letta.test.ts",
    "smoke:letta:integration": "tsx scripts/letta-integration.ts",
    "smoke:letta": "tsx scripts/letta-smoke.ts",
    "start": "tsx src/ppa-terminal.ts",
    "smoke:interface": "tsx scripts/ppa-integration.ts",
    "smoke:terminal": "tsx scripts/ppa-tui-smoke.ts",
    "model": "tsx src/letta-cli.ts model",
    "doctor": "tsx src/letta-cli.ts doctor",
    "build": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "smoke:live": "tsx scripts/letta-smoke.ts",
    "backup": "tsx src/letta-cli.ts backup",
    "restore": "tsx src/letta-cli.ts restore"
  },
  "dependencies": {
    "@letta-ai/letta-code": "0.31.12",
    "ppa-ink": "npm:ink@^7.1.1",
    "react": "^19.2.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
